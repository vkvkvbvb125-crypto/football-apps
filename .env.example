# Supabase 프로젝트 설정 > API 에서 확인
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Kakao Developers > 앱 설정 > 앱 키 > REST API 키
EXPO_PUBLIC_KAKAO_REST_API_KEY=your-kakao-rest-api-key

# Kakao Developers > 앱 설정 > 앱 키 > JavaScript 키 (카카오맵 지도 표시용)
EXPO_PUBLIC_KAKAO_MAPS_JS_KEY=your-kakao-maps-js-key
