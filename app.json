{
  "expo": {
    "name": "킥데이",
    "slug": "futsal-club",
    "scheme": "futsalclub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.futsalclub.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "supertoss",
          "kakaobank",
          "kbbank",
          "shinhan-sr-ansimclick"
        ]
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.futsalclub.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/KickDay_icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F0D"
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#39D98A"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "주변 풋살장/축구장을 찾을 때 현재 위치를 사용해요."
        }
      ],
      "expo-audio",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "63195f98-f8cf-46c6-9aaa-59510693219b"
      }
    },
    "owner": "qiawns00"
  }
}
