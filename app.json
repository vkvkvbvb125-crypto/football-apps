{
  "expo": {
    "name": "KickDay",
    "slug": "futsal-club",
    "scheme": "kickday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kickday.app",
      "associatedDomains": [
        "applinks:kickday.app",
        "applinks:www.kickday.app"
      ],
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "supertoss",
          "kakaobank",
          "kbbank",
          "shinhan-sr-ansimclick",
          "kakaokompassauth",
          "storykompassauth",
          "kakaolink"
        ]
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.kickday.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kickday.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/KickDay_icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F0D"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진을 바꾸려면 사진 접근이 필요해요."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#39D98A"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "주변 풋살장/축구장을 찾을 때 현재 위치를 사용해요."
        }
      ],
      "expo-audio",
      "expo-font",
      "./plugins/withSendAppQueries",
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "540666fcaf16d5cb3c838064fec13b99"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "63195f98-f8cf-46c6-9aaa-59510693219b"
      }
    },
    "owner": "qiawns00"
  }
}
