{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_ADS": "test"
      }
    },
    "preview": {
      "environment": "production",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ADS": "test"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_ADS": "real"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ADS": "test"
      }
    },
    "closedtest": {
      "extends": "production",
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_ADS": "test"
      }
    },
    "screenshot": {
      "extends": "production",
      "autoIncrement": false,
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SCREENSHOT": "1",
        "EXPO_PUBLIC_ADS": "test"
      }
    }
  }
}
