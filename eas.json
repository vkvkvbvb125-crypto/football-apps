{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "production"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "screenshot": {
      "extends": "production",
      "autoIncrement": false,
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SCREENSHOT": "1"
      }
    }
  }
}
